# Flask Secret Key (required)
# Generate a secure random string for production
SECRET_KEY=your-secret-key-here

# Admin Password (required)
# Password for the admin account
ADMIN_PASSWORD=your-admin-password-here

# MongoDB Configuration (required)
# MongoDB Atlas connection details
MONGO_USER=your-mongodb-username
MONGO_PASSWORD=your-mongodb-password
MONGO_HOST=your-mongodb-atlas-host

# Redis Cache URL (optional)
# If not set, the application will use fakeredis for local development
REDIS_DATA_URL=redis://localhost:6379/0

# Google Books API Key (optional)
# For increased rate limits on Google Books API
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_BOOKS_API_KEY=your-google-books-api-key
